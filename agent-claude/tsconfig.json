{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "types": ["bun"],
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,
    "paths": {
      "@shared/*": ["../shared/*"],
      // Pin zod to this package's single copy. The SDK declares zod as a peer
      // (^4.0.0); without this, tsc resolution can walk past the in-repo copy
      // up to a stray zod elsewhere on the machine, producing two structurally
      // incompatible zod types and spurious tool() argument errors. Runtime is
      // unaffected — bun already resolves the SDK's peer to this same copy.
      "zod": ["./node_modules/zod"],
      "zod/*": ["./node_modules/zod/*"]
    }
  }
}
