{
  "name": "freedungeon-monorepo",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "integrations/agent-claude"
  ],
  "scripts": {
    "//": "Passthroughs so the common workflows don't need a cd. `cd` rather than `bun --filter` because filtered output is prefixed and elided, which mangles the vite build and watch mode.",
    "build": "cd server && bun run build",
    "start": "cd server && bun run start",
    "dev": "cd server && bun run dev",
    "dev:client": "cd client && bun run dev"
  },
  "catalog": {
    "@trpc/client": "^11.16.0",
    "@types/bun": "^1.3.12",
    "nanoid": "^5.1.7",
    "solid-js": "^1.9.12",
    "typescript": "^5.7.2",
    "zod": "^4.3.6"
  },
  "dependencies": {
    "zod": "catalog:"
  }
}
